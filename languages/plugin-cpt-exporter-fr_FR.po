#. Plugin Name of the plugin
#: plugin-cpt-exporter.php
msgid "(Evan) - CPT Exporter Plugin"
msgstr "(Evan) - CPT Exporter Plugin"

#. Description of the plugin
#: plugin-cpt-exporter.php
msgid "Exports custom post types."
msgstr "Exporte les types de contenu personnalisés."

#. Author of the plugin
#: plugin-cpt-exporter.php
msgid "Evan BOMBART"
msgstr "Evan BOMBART"

#: includes/cpt-exporter-button.php:20
msgid "Export"
msgstr "Exporter"

#: includes/cpt-exporter-export.php:9
msgid "Sorry, you are not allowed to export content."
msgstr "Désolé, vous n’avez pas l’autorisation d’exporter du contenu."

